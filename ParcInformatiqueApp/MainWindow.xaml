<Window x:Class="ParcInformatiqueApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du Parc Informatique - Connexion" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Bannière Gauche -->
        <Border Grid.Column="0" Background="#1E293B" CornerRadius="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <TextBlock Text="Parc IT" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Gestion &amp; Maintenance" Foreground="#94A3B8" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Formulaire de connexion -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40">
            <TextBlock Text="Connexion" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>

            <TextBlock Text="Identifiant" Foreground="#475569" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Height="38" FontSize="14" Padding="8,5" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <TextBlock Text="Mot de passe" Foreground="#475569" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="38" FontSize="14" Padding="8,5" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

            <Button Content="Se connecter" Height="40" Background="#2563EB" Foreground="White" 
                    FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="BtnLogin_Click"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12" Margin="0,15,0,0" 
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
