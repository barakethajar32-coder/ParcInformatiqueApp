<UserControl x:Class="ParcInformatiqueApp.Views.ReferentielView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="Référentiels"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextColor}"
                   Margin="0,0,0,20"/>

        <!-- Contenu -->
        <TabControl Grid.Row="1">

            <!-- SERVICES -->
            <TabItem Header="Services">

                <StackPanel Margin="15">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <TextBox x:Name="TxtNomService"
                                 Width="250"
                                 Height="35"
                                 Margin="0,0,10,0"/>

                        <Button Content="Ajouter Service"
                                Width="150"
                                Click="BtnAddService_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="DgServices"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding IdService}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Nom du service"
                                                Binding="{Binding NomService}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </TabItem>


            <!-- LOCALISATIONS -->
            <TabItem Header="Localisations">

                <StackPanel Margin="15">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15">

                        <TextBox x:Name="TxtBatiment"
                                 Width="150"
                                 Height="35"
                                 Margin="5"/>

                        <TextBox x:Name="TxtSalle"
                                 Width="150"
                                 Height="35"
                                 Margin="5"/>

                        <TextBox x:Name="TxtBureau"
                                 Width="150"
                                 Height="35"
                                 Margin="5"/>

                        <Button Content="Ajouter"
                                Width="120"
                                Click="BtnAddLocalisation_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="DgLocalisations"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"/>

                </StackPanel>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>
