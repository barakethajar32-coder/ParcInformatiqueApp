<Window x:Class="ParcInformatiqueApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="{StaticResource BackgroundColor}">

        <Border Width="320"
                Padding="30"
                Background="White"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Gestion du Parc Informatique"
                           FontSize="20"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                <TextBlock Text="Identifiant"/>

                <TextBox x:Name="TxtLogin"
                         Height="35"
                         Margin="0,5,0,15"/>

                <TextBlock Text="Mot de passe"/>

                <PasswordBox x:Name="TxtPassword"
                             Height="35"
                             Margin="0,5,0,15"/>

                <!-- TEMPORAIRE POUR TESTER LES RÔLES -->

                <TextBlock Text="Rôle"/>

                <ComboBox x:Name="CmbRole"
                          Height="35"
                          Margin="0,5,0,20">

                    <ComboBoxItem Content="Employé"/>
                    <ComboBoxItem Content="Responsable"/>

                </ComboBox>

                <Button Content="Se connecter"
                        Height="40"
                        Click="BtnLogin_Click"/>

                <Button Content="Créer un compte"
                        Background="Transparent"
                        Foreground="{StaticResource AccentColor}"
                        Click="BtnRegister_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>