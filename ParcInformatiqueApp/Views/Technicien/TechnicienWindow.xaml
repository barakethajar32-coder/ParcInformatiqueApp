<Window x:Class="ParcInformatiqueApp.Views.Technicien.TechnicienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espace Technicien"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="White">

            <StackPanel Margin="15">

                <TextBlock Text="PARC INFORMATIQUE"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="10,15,10,30"/>

                <Button Content="Dashboard"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="BtnDashboard_Click"/>

                <Button Content="Tickets à traiter"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="BtnTickets_Click"/>

                <Button Content="Déconnexion"
                        Height="45"
                        Margin="0,30,0,0"
                        Click="BtnLogout_Click"/>

            </StackPanel>

        </Border>

        <!-- ================= CONTENU ================= -->

        <Border Grid.Column="1"
                Margin="20"
                Background="White"
                CornerRadius="10">

            <ContentControl x:Name="TechnicienContentArea"/>

        </Border>

    </Grid>

</Window>