<UserControl x:Class="ParcInformatiqueApp.Views.Employee.MesTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundColor}"
          Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITRE -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Mes tickets"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"/>

            <TextBlock Text="Consultez et suivez vos demandes d'intervention"
                       FontSize="14"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- STATISTIQUES -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,5,0">

                <StackPanel>

                    <TextBlock Text="Total"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                    <TextBlock x:Name="TxtTotal"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- EN ATTENTE -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="5,0,5,0">

                <StackPanel>

                    <TextBlock Text="En attente"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                    <TextBlock x:Name="TxtEnAttente"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- EN COURS -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="5,0,0,0">

                <StackPanel>

                    <TextBlock Text="En cours"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                    <TextBlock x:Name="TxtEnCours"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- LISTE DES TICKETS -->

        <DataGrid x:Name="DgMesTickets"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="N°"
                                    Binding="{Binding IdTicket}"
                                    Width="70"/>

                <DataGridTextColumn Header="Titre"
                                    Binding="{Binding Titre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Équipement"
                                    Binding="{Binding Equipement}"
                                    Width="*"/>

                <DataGridTextColumn Header="Date"
                                    Binding="{Binding DateCreation}"
                                    Width="130"/>

                <DataGridTextColumn Header="Priorité"
                                    Binding="{Binding Priorite}"
                                    Width="100"/>

                <DataGridTextColumn Header="Statut"
                                    Binding="{Binding Statut}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>