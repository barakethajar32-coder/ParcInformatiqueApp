<UserControl x:Class="ParcInformatiqueApp.Views.Employee.EmployeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundColor}"
          Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TITRE -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            

            <TextBlock Text="votre espace employé"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextColor}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- STATISTIQUES -->
        <Grid Grid.Row="1"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ÉQUIPEMENTS -->
            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="White">

                <StackPanel>

                    <TextBlock Text="💻"
                               FontSize="30"/>

                    <TextBlock Text="Mes équipements"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                </StackPanel>

            </Border>


            <!-- TICKETS -->
            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="White">

                <StackPanel>

                    <TextBlock Text="🎫"
                               FontSize="30"/>

                    <TextBlock Text="Mes tickets"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ACTIONS -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="25">

            <StackPanel>


                <Button Content="💻  Mes équipements"
                        Height="45"
                        Margin="0,0,0,10"/>


                <Button Content="🎫  Créer un ticket"
                        Height="45"
                        Margin="0,0,0,10"/>


                <Button Content="📋  Mes tickets"
                        Height="45"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>