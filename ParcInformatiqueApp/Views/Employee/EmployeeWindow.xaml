<Window x:Class="ParcInformatiqueApp.Views.Employee.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espace Employé"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- MENU EMPLOYE -->

        <Border Grid.Column="0"
                Background="{StaticResource PrimaryColor}">

            <StackPanel Margin="10">

                <TextBlock Text="ESPACE EMPLOYÉ"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="10,10,10,30"/>


                <Button Content="🏠 Dashboard"
                        Click="BtnDashboard_Click"
                        Margin="0,0,0,10"/>


                <Button Content="💻 Mes équipements"
                        Click="BtnEquipements_Click"
                        Margin="0,0,0,10"/>


                <Button Content="🎫 Créer un ticket"
                        Click="BtnCreateTicket_Click"
                        Margin="0,0,0,10"/>


                <Button Content="📋 Mes tickets"
                        Click="BtnMesTickets_Click"
                        Margin="0,0,0,10"/>

            </StackPanel>

        </Border>


        <!-- CONTENU -->

        <ContentControl x:Name="EmployeeContentArea"
                        Grid.Column="1"
                        Margin="20"/>

    </Grid>

</Window>
