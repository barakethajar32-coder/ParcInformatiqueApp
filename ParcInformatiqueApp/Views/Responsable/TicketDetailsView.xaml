<UserControl x:Class="ParcInformatiqueApp.Views.TicketDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Détails du ticket"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"
                       Margin="0,0,0,25"/>

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,15">

                <TextBlock Text="Nom du ticket"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtNomTicket"
                         Height="40"
                         Padding="10"
                         IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,15">

                <TextBlock Text="Description"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtDescription"
                         Height="80"
                         Padding="10"
                         TextWrapping="Wrap"
                         IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0,0,0,15">

                <TextBlock Text="Priorité"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtPriorite"
                         Height="40"
                         Padding="10"
                         IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,0,0,15">

                <TextBlock Text="Statut"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtStatut"
                         Height="40"
                         Padding="10"
                         IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Row="5"
                        Margin="0,0,0,15">

                <TextBlock Text="Diagnostic"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtDiagnostic"
                         Height="70"
                         Padding="10"
                         TextWrapping="Wrap"
                         IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Row="6">

                <TextBlock Text="Action réalisée"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtAction"
                         Height="70"
                         Padding="10"
                         TextWrapping="Wrap"
                         IsReadOnly="True"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>