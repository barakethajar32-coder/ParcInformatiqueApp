<Window x:Class="ParcInformatiqueApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du Parc Informatique"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= NETWORK ALERT ================= -->

        <Border x:Name="NetworkAlertBanner"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#DC2626"
                Visibility="Collapsed"
                Padding="8">

            <TextBlock
                Text="⚠ Connexion réseau perdue. Mode hors-ligne activé."
                Foreground="White"
                HorizontalAlignment="Center"
                FontWeight="Bold"/>

        </Border>


        <!-- ================= SIDE MENU ================= -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource PrimaryColor}">

            <StackPanel Margin="10">

                <Button x:Name="BtnEquipements"
                        Content="Équipements"
                        Click="NavEquipements_Click"/>

                <Button x:Name="BtnEmployes"
                        Content="Employés"
                        Click="NavEmployes_Click"/>

                <Button x:Name="BtnTickets"
                    Content="Tickets"
                    Click="NavTickets_Click"/>

                <Button x:Name="BtnReferentiels"
                        Content="Référentiels"
                        Click="NavReferentiels_Click"/>

                <Button x:Name="BtnValidationUsers"
                        Content="Validation Comptes"
                        Click="NavValidation_Click"/>
                <Button Content="Déconnexion"
                   Click="BtnDeconnexion_Click"/>

            </StackPanel>

        </Border>


        <!-- ================= CONTENT ================= -->

        <ContentControl
            x:Name="MainContentArea"
            Grid.Row="1"
            Grid.Column="1"
            Margin="20"/>

    </Grid>

</Window>