<Window x:Class="ParcInformatiqueApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer un compte"
        Height="600"
        Width="450"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="30">

            <TextBlock
                Text="Créer un compte"
                FontSize="25"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,25"/>

            <TextBlock Text="Nom"/>
            <TextBox x:Name="TxtNom" Margin="0,5,0,10"/>

            <TextBlock Text="Prénom"/>
            <TextBox x:Name="TxtPrenom" Margin="0,5,0,10"/>

            <TextBlock Text="Mot de passe"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,5,0,10"/>

            <TextBlock Text="Service"/>
            <ComboBox x:Name="CboService" 
          DisplayMemberPath="NomService" 
          SelectedValuePath="IdService" 
          Margin="0,5,0,10"/>

            <TextBlock Text="Poste"/>
            <TextBox x:Name="TxtPoste" Margin="0,5,0,10"/>

            <TextBlock Text="Rôle"/>
            <ComboBox x:Name="CboRole" Margin="0,5,0,20">
                <ComboBoxItem Content="Employé"/>
                <ComboBoxItem Content="Technicien"/>
                <ComboBoxItem Content="Responsable informatique"/>
            </ComboBox>

            <Button
                Content="Créer le compte"
                Height="40"
                Click="BtnRegister_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>